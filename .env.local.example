# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (Settings → API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser.
# Only needed if you add admin-only routes later.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Comma-separated list of Google account emails allowed into /admin with
# FULL access (products, settings, orders, inquiries — everything).
ADMIN_EMAILS=adminacc0935@gmail.com

# Comma-separated list of emails allowed into /admin with STAFF access
# only — orders and inquiries, no product catalog or site settings.
# Leave blank if you don't need a staff tier yet.
STAFF_EMAILS=

# --- Email notifications (sent from a real Gmail inbox) ---
# The Gmail account itself, and an App Password for it (NOT the normal
# Gmail password — see README for how to generate one).
GMAIL_USER=adminacc0935@gmail.com
GMAIL_APP_PASSWORD=

# --- PayPal (developer.paypal.com → Apps & Credentials) ---
# Use Sandbox credentials while testing, Live credentials at launch.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com while testing,
# https://api-m.paypal.com in production.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
